<section
    class='tab {{tabs.settings.cssClass}} {{tabs.settings.id}}'
    data-tab='{{tabs.settings.id}}'
    data-group='{{tabs.settings.group}}'
>

    <fieldset>
        <legend>{{localize tabs.settings.label}}</legend>
        <span>Rarirty</span>
        <select name='system.rarity'>
            {{selectOptions config.rarity selected=source.system.rarity localize=true}}
        </select>

        <span>Quantity</span>
        <input type='number' name='system.quantity' value='{{source.system.quantity}}' />

        <span>Size</span>
        <input type='number' name='system.size' value='{{source.system.size}}' />

        <span>Price</span>
        <input type='number' name='system.price' value='{{source.system.price}}' />
    </fieldset>
</section>