<section>
    <div>
        <img src='{{actor.img}}' data-edit='img' title='{{actor.name}}' style='height: 200px; width: 200px;' />
        <div>
            <div>
                <h4>life</h4>
                <h4>defense</h4>
            </div>
        </div>
    </div>
    <div>
        <h1>
            <input
                class='char-data-name'
                name='name'
                type='text'
                value='{{actor.name}}'
                placeholder='{{localize "ASTRO.actor.name"}}'
            />
        </h1>
        <div>
            <h4>strenght</h4>
            <h4>intelligence</h4>
            <h4>dexterity</h4>
            <h4>charisma</h4>
        </div>
    </div>
</section>