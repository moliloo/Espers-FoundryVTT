<section
    class='tab {{tabs.description.cssClass}} {{tabs.description.id}}'
    data-tab='{{tabs.description.id}}'
    data-group='{{tabs.description.group}}'
>
    <div class='sheet-section sheet-description'>
        {{formInput
            fields.description
            value=source.system.description
            enriched=description
            toggled=true
            compact=true
            classes='slim'
        }}
    </div>
</section>